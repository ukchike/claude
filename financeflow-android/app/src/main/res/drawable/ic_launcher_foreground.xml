<?xml version="1.0" encoding="utf-8"?>
<!-- FinanceFlow mark: a bold rising "growth" arrow, split into two tones the way the
     reference design language splits its glyph — pale mint on the leading half, solid
     white on the trailing half and arrowhead. Flat, rounded, no shadows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- leading (lower-left) half of the trend line -->
    <path
        android:strokeColor="#A7F3D0"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M29,67 L47,49 L58,60" />
    <!-- trailing (upper-right) half -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M58,60 L78,40" />
    <!-- arrowhead: an L-bracket with round joins, corner sitting on the end of the line -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M62,40 L78,40 L78,56" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews only support a limited view subset (no custom views, no CSS) — kept deliberately
     plain: title, balance, one budget line, and a small "+ Add" button pinned bottom-right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FinanceFlow"
        android:textColor="#8b8b93"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textColor="#f2f2f5"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_budget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Open FinanceFlow to sync"
        android:textColor="#8b8b93"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/widget_add_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="+ Add"
        android:textAllCaps="false"
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:background="@drawable/widget_btn_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />
</LinearLayout>
